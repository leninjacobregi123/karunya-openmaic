# Committed dev environment for docker-compose.remote.yml, so a plain
# `docker compose -f docker-compose.remote.yml up -d --build` works with
# zero prior setup on a fresh clone. See .env.remote.example for the meaning
# of every value.
#
# These are DEV-GRADE secrets shared in the repo. Fine for a single-admin
# lab box (shannon); replace every value below with your own before this
# host is ever reachable by anyone but you.

# --- Secrets ---------------------------------------------------------------
POSTGRES_PASSWORD=maic_dev_pw_2f8a1c
MINIO_ROOT_PASSWORD=maic_dev_pw_2f8a1c
SESSION_SECRET=maic-dev-session-secret-9e1b4d7a2f6c8035ab19de4f7c2a8b6e1d5f0937c4a8b1e6d2f9c3a7b5e0186f

# --- Dev accounts ------------------------------------------------------------
# true = seed admin@karunya.edu/teacher123 + student1/student2 (weak,
# well-known passwords - fine for a first smoke test, NOT for anything real).
MAIC_SEED_DEV_USERS=true

# --- Models ------------------------------------------------------------------
# Matches the containerized `vllm` service (profile local-vllm), which is
# activated automatically by COMPOSE_PROFILES below.
MAIC_VLLM_MODEL=Qwen/Qwen3-32B-AWQ
MAIC_VLLM_BASE_URL=http://vllm:8000/v1

# --- Profiles ------------------------------------------------------------------
# Auto-activates the containerized vllm service on a plain `docker compose up`
# (no --profile flag needed). Add ",media" to also bring up image/tts by
# default - see docker-compose.remote.yml's header comment for why they're
# not on together with vllm by default (GPU footprint). Unset this (or
# override per-invocation: `COMPOSE_PROFILES= docker compose ... up`) if
# pointing at an external vLLM instead.
COMPOSE_PROFILES=local-vllm

# --- Ports (host-side; change if already taken) -------------------------------
MAIC_APP_PORT=3000
MAIC_MINIO_CONSOLE_PORT=9001
